<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Disaster Alleviation Foundation" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#2196F3" Padding="20">
            <StackPanel>
                <TextBlock Text="🌍 Disaster Alleviation Foundation" 
                          FontSize="24" 
                          FontWeight="Bold" 
                          Foreground="White" 
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Making a Difference Together" 
                          FontSize="14" 
                          Foreground="#E3F2FD" 
                          HorizontalAlignment="Center" 
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left Side - Login/Register -->
            <Border Grid.Column="0" Background="#F8F9FA" Padding="40">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Welcome to Our Community" 
                              FontSize="28" 
                              FontWeight="Bold" 
                              Foreground="#333" 
                              HorizontalAlignment="Center" 
                              Margin="0,0,0,30"/>
                    
                    <TextBlock Text="Join thousands of volunteers and donors making a real difference in disaster-affected communities worldwide." 
                              FontSize="16" 
                              Foreground="#666" 
                              TextWrapping="Wrap" 
                              TextAlignment="Center" 
                              LineHeight="24" 
                              Margin="0,0,0,40"/>
                    
                    <Button x:Name="LoginButton" 
                           Content="Sign In / Register" 
                           Background="#2196F3" 
                           Foreground="White" 
                           BorderThickness="0" 
                           Padding="30,15" 
                           FontSize="18" 
                           FontWeight="SemiBold" 
                           Cursor="Hand" 
                           Click="LoginButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="10" 
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" 
                                                    VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1976D2"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#1565C0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
            
            <!-- Right Side - Information -->
            <Border Grid.Column="1" Background="White" Padding="40">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Our Impact" 
                              FontSize="24" 
                              FontWeight="Bold" 
                              Foreground="#333" 
                              HorizontalAlignment="Center" 
                              Margin="0,0,0,30"/>
                    
                    <StackPanel>
                        <Border Background="#E8F5E8" 
                               BorderBrush="#4CAF50" 
                               BorderThickness="1" 
                               CornerRadius="8" 
                               Padding="20" 
                               Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏠" FontSize="24" Margin="0,0,15,0"/>
                                <StackPanel>
                                    <TextBlock Text="50,000+" 
                                              FontSize="20" 
                                              FontWeight="Bold" 
                                              Foreground="#2E7D32"/>
                                    <TextBlock Text="Families Helped" 
                                              FontSize="14" 
                                              Foreground="#4CAF50"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <Border Background="#E3F2FD" 
                               BorderBrush="#2196F3" 
                               BorderThickness="1" 
                               CornerRadius="8" 
                               Padding="20" 
                               Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌍" FontSize="24" Margin="0,0,15,0"/>
                                <StackPanel>
                                    <TextBlock Text="25+" 
                                              FontSize="20" 
                                              FontWeight="Bold" 
                                              Foreground="#1565C0"/>
                                    <TextBlock Text="Countries Reached" 
                                              FontSize="14" 
                                              Foreground="#2196F3"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <Border Background="#FFF3E0" 
                               BorderBrush="#FF9800" 
                               BorderThickness="1" 
                               CornerRadius="8" 
                               Padding="20">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🤝" FontSize="24" Margin="0,0,15,0"/>
                                <StackPanel>
                                    <TextBlock Text="10,000+" 
                                              FontSize="20" 
                                              FontWeight="Bold" 
                                              Foreground="#E65100"/>
                                    <TextBlock Text="Active Volunteers" 
                                              FontSize="14" 
                                              Foreground="#FF9800"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
